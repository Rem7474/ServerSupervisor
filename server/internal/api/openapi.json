{
  "openapi": "3.0.3",
  "info": {
    "title": "ServerSupervisor API",
    "version": "1",
    "description": "Public subset of the ServerSupervisor REST API, for scripts and third-party tools.\n\nAuthenticate with a personal API key created in *My account → API keys*: `Authorization: Bearer ssk_…`. A key acts as the user who created it, with that user's current role and host permissions, narrowed by its scope: a `read` key only reaches GET requests, a `write` key also reaches the write endpoints its owner may use. Account, users, API keys, settings and integration credentials are never reachable with a key.\n\nErrors are returned as `{\"error\", \"code\", \"i18nKey\"}`; `error` follows the `Accept-Language` header (en, fr).",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
