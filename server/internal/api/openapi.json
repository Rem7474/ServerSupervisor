    "/hosts/{id}/maintenance-windows": {
      "post": {
        "operationId": "createHostMaintenanceWindow",
        "summary": "Create a maintenance window on a host",
        "description": "Operator rights on the host and a write-scoped key required. Alerts of the host are muted during the window.",
        "tags": [
          "Maintenance"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/HostID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintenanceWindowRequest"
              }
            }
          }
        },
        "responses": {
