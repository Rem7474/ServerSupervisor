{
  "name": "serversupervisor-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.vue\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "gen:types": "cd ../server && go run github.com/gzuidhof/tygo@v0.2.21 generate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:coverage": "vitest run --config vitest.browser.config.ts --coverage"
  },
  "dependencies": {
    "@tabler/core": "^1.0.0",
    "@tabler/icons-vue": "^3.46.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apexcharts": "^6.8.0",
    "axios": "^1.19.0",
    "cytoscape": "^3.34.2",
    "cytoscape-fcose": "^2.2.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "mitt": "^3.0.1",
    "pinia": "^4.0.3",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue3-apexcharts": "^1.11.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cytoscape": "^3.21.9",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.3.0",
    "@types/topojson-client": "^3.1.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "playwright": "^1.62.1",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vitest": "^4.1.7",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
